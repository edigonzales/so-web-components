{
  "name": "so-web-components",
  "version": "0.1.6",
  "repository": {
    "type": "git",
    "url": "https://github.com/edigonzales/so-web-components.git"
  },  
  "homepage": "https://github.com/edigonzales/so-web-components#readme",  
  "bugs": {
    "url": "https://github.com/edigonzales/so-web-components/issues"
  },  
  "private": false,
  "type": "module",
  "description": "Vanilla TypeScript Web Components inspired by so.ch layout (tokens + header component).",
  "author": "edigonzales <stefan.ziegler.de@gmail.com>",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:assets",
    "pretest": "npm run build && tsc -p tsconfig.tests.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "dev": "node scripts/dev-server.mjs",
    "dev:watch": "node scripts/dev-watch.mjs",
    "dev:hot": "node scripts/dev-hot.mjs",
    "lint": "node scripts/simple-lint.mjs",
    "build:assets": "node scripts/copy-assets.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "jest-environment-jsdom": "^29.7.0",
    "jest": "^29.7.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.6.3",
    "glob": "^10.4.5"
  }
}
